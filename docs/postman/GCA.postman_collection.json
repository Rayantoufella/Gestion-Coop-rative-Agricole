              "});",
              "pm.test('Rôle gestionnaire', function () {",
              " pm.expect(pm.response.json().user.role).to.eql('gestionnaire');",
              "});",
              "pm.collectionVariables.set('gestionnaireToken', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
