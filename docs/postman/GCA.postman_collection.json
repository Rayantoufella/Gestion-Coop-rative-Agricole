{
  "info": {
    "name": "GCA - Gestion de Coopérative Agricole",
    "description": "Vérifications de l'API : connexion Sanctum, droits des deux rôles et contrôle du stock. Aucune requête ne modifie les données de démo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Connexion administrateur",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{motDePasse}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Connexion réussie (200)', function () {",
              " pm.response.to.have.status(200);",
              "});",
              "pm.test('Rôle admin', function () {",
              " pm.expect(pm.response.json().user.role).to.eql('admin');",
              "});",
              "pm.collectionVariables.set('adminToken', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Connexion gestionnaire",
      "request": {
        "method": "POST",
        "header": [
          {
