    {
      "name": "10. Gestionnaire : vente supérieure au stock refusée",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{gestionnaireToken}}"
          }
        ],
        "url": "{{baseUrl}}/ventes-groupees",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"produit_id\": \"{{produitId}}\",\n  \"acheteur_id\": \"{{acheteurId}}\",\n  \"date_vente\": \"2026-01-15\",\n  \"quantite\": 999999,\n  \"prix_unitaire\": 10\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Vente refusée (422)', function () {",
              " pm.response.to.have.status(422);",
              "});",
              "pm.test('Message stock insuffisant', function () {",
              " const json = pm.response.json();",
              " pm.expect(json.message).to.eql('Stock insuffisant.');",
              " pm.expect(json).to.have.property('stock_disponible');",
              "});"
            ]
          }
        }
      ]
    },
